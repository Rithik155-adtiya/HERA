# HERA Server configuration — copy to .env and fill in real values.
# NEVER commit real secrets.

# Runtime environment: development | production | test
NODE_ENV=development
PORT=5000

# MongoDB Atlas (or local MongoDB) connection string
MONGODB_URI=mongodb://localhost:27017/hera

# JWT signing secret — at least 32 characters. Generate with: openssl rand -hex 32
JWT_SECRET=

# JWT lifetime (default 7d)
JWT_EXPIRES_IN=7d

# Frontend origin(s), comma-separated for multiple
CLIENT_URL=http://localhost:5173

# Google Gemini API key (optional — without it the app runs in
# clearly-labelled manual-review mode, AI analysis is skipped)
GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200

# Logging: error | warn | info | debug
LOG_LEVEL=info

# Cloudinary (only if attachments are enabled later — not required)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Development seed accounts (used only by `npm run seed`) ---
SEED_ADMIN_PASSWORD=Admin@123
SEED_WARDEN_PASSWORD=Warden@123
SEED_STUDENT_PASSWORD=Student@123
SEED_STAFF_PASSWORD=Staff@123
